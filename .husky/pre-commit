#!/usr/bin/env sh
if ! command -v npx >/dev/null 2>&1; then
  echo "⚠️  npx not found in PATH — skipping pre-commit hooks"
  echo "   Run 'npm run lint' manually before pushing."
  exit 0
fi

# Prettier + ESLint on staged files. The inherited OmniRoute gates
# (docs-sync, any-budget, tracked-artifacts) were removed with their scripts:
# they referenced files that no longer exist in JRoute and enforced nothing.
npx lint-staged
